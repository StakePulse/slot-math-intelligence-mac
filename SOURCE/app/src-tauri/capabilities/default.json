{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Fenêtre principale : commandes de l'application, dialogues de fichiers, ouverture de dossiers.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "**" }] }
  ]
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slot Math Intelligence",
  "version": "0.2.0",
  "identifier": "com.oraclelabs.slotmathintelligence",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5181",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Slot Math Intelligence",
        "width": 1480,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "category": "Utility",
    "shortDescription": "Laboratoire mathématique des slots",
    "longDescription": "Analyse du marché des slots Stake Engine, moteur mathématique exact, simulateur multithread reproductible, générateur de modèles et de prompts pour Claude.",
    "copyright": "Oracle Labs",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../../packs/commun": "starter",
      "../../../DOCS/GUIDE_UTILISATEUR.md": "starter/DOCS/GUIDE_UTILISATEUR.md",
      "../../../DOCS/INSTALLATION_WINDOWS.md": "starter/DOCS/INSTALLATION_WINDOWS.md",
      "../../../DOCS/INSTALLATION_MAC.md": "starter/DOCS/INSTALLATION_MAC.md"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "languages": ["French"],
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": { "width": 640, "height": 400 },
        "appPosition": { "x": 180, "y": 190 },
        "applicationFolderPosition": { "x": 460, "y": 190 }
      }
    }
  }
}
